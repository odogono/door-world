{
  "name": "@odogono/door-world",
  "version": "1.0.0",
  "description": "A navigable (somewhat) procedurally generated world with a lot of doors",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:odogono/door-world",
  "packageManager": "bun@1.4.5",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__test__"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun --hot ./dev/index.html",
    "embed-assets": "bun scripts/embed-assets.ts",
    "test": "bun test",
    "tsc": "tsc --noEmit",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run tsc && bun run lint && bun run format:check && bun test",
    "outdated": "bunx npm-check-updates --interactive --format group"
  },
  "dependencies": {
    "@react-spring/three": "9.7.5",
    "chroma-js": "^3.3.0",
    "jotai": "^2.20.3"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.177.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/eslint-plugin": "^0.1.2",
    "@react-three/fiber": "^9.8.2",
    "@types/bun": "^1.4.5",
    "@types/chroma-js": "^3.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "~6.0.3"
  }
}
